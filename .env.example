# =============================================================================
# Text-to-SQL Engine — example environment configuration
# Copy to `.env` and adjust. NEVER commit a real `.env` with secrets.
# All variables are prefixed with T2SQL_ and are parsed by
# text_to_sql.configuration.settings.Settings (Pydantic Settings).
# =============================================================================

# --- Runtime -----------------------------------------------------------------
T2SQL_ENVIRONMENT=development        # development | staging | production | test
T2SQL_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
T2SQL_LOG_JSON=true                  # structured JSON logs (true in prod)
T2SQL_API_HOST=0.0.0.0
T2SQL_API_PORT=8000

# --- Database ----------------------------------------------------------------
# Default (local/dev/test): file-backed SQLite, zero external dependencies.
# For PostgreSQL use e.g.:
#   T2SQL_DATABASE_URL=postgresql+psycopg://t2sql:t2sql@localhost:5432/t2sql
T2SQL_DATABASE_URL=sqlite:///./data/text_to_sql.db
# Optional dedicated read-only URL/role used by the executor. Falls back to
# T2SQL_DATABASE_URL when unset. In production, point this at a read-only role.
T2SQL_READONLY_DATABASE_URL=
T2SQL_DB_POOL_SIZE=5
T2SQL_DB_MAX_OVERFLOW=5
T2SQL_DB_POOL_TIMEOUT_SECONDS=10

# --- SQL dialect & safety limits ---------------------------------------------
T2SQL_SQL_DIALECT=sqlite             # sqlite | postgres (default target dialect)
T2SQL_MAX_ROWS=1000                  # hard cap injected as LIMIT
T2SQL_STATEMENT_TIMEOUT_MS=5000
T2SQL_MAX_JOINS=6
T2SQL_MAX_SUBQUERY_DEPTH=4
T2SQL_MAX_SELECTED_COLUMNS=60
T2SQL_COST_ROWS_HIGH_THRESHOLD=1000000
T2SQL_COST_ROWS_MEDIUM_THRESHOLD=100000

# --- LLM provider ------------------------------------------------------------
# Provider is pluggable. "fake" is deterministic and requires no credentials
# (used by all tests and CI). "openai" targets any OpenAI-compatible endpoint.
T2SQL_LLM_PROVIDER=fake              # fake | openai
T2SQL_LLM_MODEL=deterministic-fake
T2SQL_LLM_BASE_URL=https://api.openai.com/v1
# The API KEY is read from this env var NAME (never inline the secret in config):
T2SQL_LLM_API_KEY_ENV=OPENAI_API_KEY
OPENAI_API_KEY=                      # leave empty unless using the openai provider
T2SQL_LLM_TIMEOUT_SECONDS=30
T2SQL_LLM_MAX_RETRIES=2
T2SQL_LLM_TEMPERATURE=0.0

# --- Pipeline behaviour ------------------------------------------------------
T2SQL_MAX_REPAIR_ATTEMPTS=2
T2SQL_SCHEMA_CACHE_TTL_SECONDS=300
T2SQL_ENABLE_RESULT_CACHE=false
T2SQL_RETRIEVAL_TOP_K=12
T2SQL_DISCLOSE_MODEL_METADATA=true   # include provider/model in responses

# --- Observability -----------------------------------------------------------
T2SQL_METRICS_ENABLED=true
T2SQL_TRACING_ENABLED=true

# --- Authorization / multi-tenancy ------------------------------------------
# Comma-separated allowlists. Empty means "no restriction beyond schema catalog".
T2SQL_ALLOWED_SCHEMAS=
T2SQL_TENANT_COLUMN=organization_id  # column used for mandatory tenant predicates
